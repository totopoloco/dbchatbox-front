#!/usr/bin/expect -f

set timeout -1

spawn pnpm approve-builds
expect {
    "There are no packages awaiting approval" {
        puts "No packages to approve."
        exit 0
    }
    "Choose which packages to build" {
        send -- "a\r"
        exp_continue
    }
    -re {The next packages will now be built:.*} {
        # Proceed to approval prompt
        exp_continue
    }
    -re {Do you approve\?.*} {
        send -- "y\r"
        exp_continue
    }
    eof { }
}
