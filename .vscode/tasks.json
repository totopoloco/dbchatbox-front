{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "web",
      "label": "npm run web",
      "isBackground": true,
      "detail": "Starts the Expo web dev server",
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": "^(\\S+):(\\d+):\\s+(.*)$",
              "file": 1,
              "line": 2,
              "message": 3
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "Starting|Bundling",
            "endsPattern": "Metro waiting on|Bundled|compiled successfully"
          }
        }
      ]
    }
  ]
}
